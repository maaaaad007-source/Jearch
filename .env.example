# ---------------------------------------------------------------------------
# Jearch configuration
#
# There is no demo mode. If a source is not configured the app says so, on the
# page, instead of inventing postings — sample data that looked real cost more
# confusion than it ever saved.
#
# Open /setup on any deployment to see which of these actually arrived.
# ---------------------------------------------------------------------------

# --- Jobs ------------------------------------------------------------------
# Adzuna — https://developer.adzuna.com — a jobs database covering
# AT AU BE BR CA CH DE ES FR GB IN IT MX NL NZ PL SG US ZA.
#
# Adzuna's dashboard labels these "Application ID" and "Application Keys".
# In a hosting dashboard, the left-hand box is the *variable name* below, and
# the right-hand box is the value from Adzuna — putting the ID in the name box
# is the single most common way to end up with no results.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Sweden is covered by Platsbanken (jobtechdev.se), which is open data and
# needs no credential — Swedish searches work with nothing set at all.
# JOBTECH_DISABLED=true   # opt out of it entirely

# --- Who to contact --------------------------------------------------------
# Serper — https://serper.dev — Google results, used to find the recruiter or
# hiring lead on LinkedIn. Costs a fraction of Apollo or Hunter and works from
# a company name, so it answers for employers those services have never
# indexed. Without it, postings still work; contact panels stay empty.
SERPER_API_KEY=

# --- Saved opportunities (optional) ----------------------------------------
# Bookmarks live in the browser by default. Set both of these to mirror them
# to Supabase so they follow you between devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Testing seams ---------------------------------------------------------
# Point a source at a local stub instead of the real host. Only useful for
# development; leave unset in a deployment.
# ADZUNA_ENDPOINT=http://127.0.0.1:4501
# JOBTECH_ENDPOINT=http://127.0.0.1:4503/search
# SERPER_ENDPOINT=http://127.0.0.1:4502
