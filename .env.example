# ---------------------------------------------------------------------------
# Jearch configuration
#
# Every key below is optional. With none of them set the app runs in demo mode:
# seeded, clearly-labelled synthetic postings and contacts, so you can click
# through the whole flow before paying for anything.
# ---------------------------------------------------------------------------

# --- Job search (pick one) -------------------------------------------------
# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# TheirStack — https://theirstack.com/en/docs/api
THEIRSTACK_API_KEY=

# --- Contact enrichment (pick one) -----------------------------------------
# Apollo.io — https://docs.apollo.io/reference/people-search
APOLLO_API_KEY=

# Hunter.io — https://hunter.io/api-documentation/v2#domain-search
HUNTER_API_KEY=

# --- Provider selection (optional) -----------------------------------------
# By default the app uses whichever key is present, preferring JSearch and
# Apollo. Set these to pin a provider, or to "demo" to force sample data.
# JOB_PROVIDER=jsearch|theirstack|demo
# CONTACT_PROVIDER=apollo|hunter|demo

# --- Saved opportunities (optional) ----------------------------------------
# Without Supabase, bookmarks persist in the browser via localStorage.
# With it, they also sync server-side. Schema: supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
