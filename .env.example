# ---------------------------------------------------------------------------
# Jearch configuration
#
# Every key below is optional. With none of them set the app runs in demo mode:
# seeded, clearly-labelled synthetic postings and contacts, so you can click
# through the whole flow before paying for anything.
# ---------------------------------------------------------------------------

# --- Job search (pick one) -------------------------------------------------
# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Only needed if JSearch renames its search endpoint again. The adapter tries
# /search-v2 then /search and remembers whichever answers; set this to pin the
# path shown in the code snippet on the API's RapidAPI page.
# JSEARCH_PATH=/search-v2

# TheirStack — https://theirstack.com/en/docs/api
THEIRSTACK_API_KEY=

# Serper — https://serper.dev — a Google Search API, not a jobs API. Used here
# to pull LinkedIn job pages out of Google's index (one credit per search), and
# below to find decision makers. Far cheaper than the enrichment vendors.
SERPER_API_KEY=

# --- Contact enrichment (pick one) -----------------------------------------
# Apollo.io — https://docs.apollo.io/reference/people-search
APOLLO_API_KEY=

# Hunter.io — https://hunter.io/api-documentation/v2#domain-search
HUNTER_API_KEY=

# Serper doubles as the contact source (same SERPER_API_KEY above): it finds
# LinkedIn profiles of recruiters and hiring leads at the company. It returns
# name, role and profile URL — never a verified email, since a search engine
# cannot verify one.
#
# When a posting carries no company website, one extra credit per company is
# spent resolving it so a pattern-guess email can be offered. Those are always
# labelled as guesses. Set to false to skip the lookup and halve the credits.
# SERPER_RESOLVE_DOMAINS=false

# --- Provider selection (optional) -----------------------------------------
# By default the app uses whichever key is present, preferring JSearch and
# Apollo. Set these to pin a provider, or to "demo" to force sample data.
# JOB_PROVIDER=jsearch|theirstack|demo
# CONTACT_PROVIDER=apollo|hunter|demo

# --- Saved opportunities (optional) ----------------------------------------
# Without Supabase, bookmarks persist in the browser via localStorage.
# With it, they also sync server-side. Schema: supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
